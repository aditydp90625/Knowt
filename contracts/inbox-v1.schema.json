{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowt.local/schemas/inbox-v1.schema.json",
  "title": "Knowt structured knowledge submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "source", "nodes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "submission_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "created_at"],
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 120 },
        "created_at": { "type": "string", "format": "date-time" },
        "conversation_title": { "type": "string", "maxLength": 240 }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_node_id", "title", "knowledge_type", "content_markdown", "topic", "project"],
        "properties": {
          "client_node_id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "knowledge_type": { "enum": ["Reference", "Practice", "Debug", "Result"] },
          "content_markdown": { "type": "string", "minLength": 1 },
          "topic": { "$ref": "#/$defs/path_hint" },
          "project": { "$ref": "#/$defs/path_hint" },
          "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "images": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/image_attachment" } }
        }
      }
    }
  },
  "$defs": {
    "image_attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "media_type", "content_base64"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^/\\\\]+$" },
        "media_type": { "enum": ["image/png", "image/jpeg", "image/gif", "image/webp", "image/avif"] },
        "content_base64": { "type": "string", "minLength": 4, "maxLength": 12000000, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "path_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_hint", "origin"],
      "properties": {
        "path_hint": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "origin": { "enum": ["llm", "user"] }
      }
    }
  }
}
